# ============================================================
#  C++ / CMake 项目 .gitignore
#  ----------------------------------------------
#  规则：
#    1. 编译产物、构建目录一律忽略
#    2. IDE / 编辑器本地配置忽略
#    3. 保留必要文件（如 .gitkeep）
# ============================================================

# ---------- CMake 构建产物 ----------
build/
build-*/
out/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/
CMakeUserPresets.json

# ---------- 编译中间文件 ----------
*.o
*.obj
*.lo
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app
*.ko
*.mod
*.slo
*.la
*.lai

# ---------- 调试 / 性能分析产物 ----------
*.dSYM/
*.su
*.idb
*.pdb
*.ilk
core
core.*
vgcore.*
perf.data*
callgrind.out.*

# ---------- IDE / 编辑器 ----------
# VS Code（仅忽略本地配置，保留共享的 .vscode/launch.json 等可按需调整）
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/c_cpp_properties.json

# Visual Studio
.vs/
*.user
*.suo
*.VC.db
*.VC.opendb
*.opendb
*.aps
*.cache

# JetBrains (CLion / IDEA)
.idea/
*.iml
*.iws
*.ipr

# Vim
*.swp
*.swo
*~
.*.sw?
Session.vim

# Emacs
*~
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# ---------- 操作系统 ----------
# Linux
*~
.directory
.Trash-*
.nfs*

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# ---------- 日志 / 临时文件 ----------
*.log
*.tmp
*.bak
*.orig
*.pid
*.seed
*.pid.lock
*.gz
*.tgz

# ---------- 依赖 / 工具链缓存 ----------
vcpkg_installed/
conan/
.cache/
.ccache/
.clangd/
compile_flags.txt
.ccls-cache/

# ---------- 覆盖率报告 ----------
*.gcno
*.gcda
*.gcov
coverage/
lcov.info

# ---------- 环境文件 ----------
.env
.env.local
*.local

# ---------- 保留目录 ----------
!.gitkeep